# Copier en .env puis remplacer les valeurs. Ne jamais versionner .env.
POSTGRES_USER=retail
POSTGRES_PASSWORD=change_me
POSTGRES_DB=retail
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL utilisée par le pipeline et le dashboard (si absente, elle est construite à partir des variables ci-dessus).
DATABASE_URL=postgresql+psycopg://retail:change_me@localhost:5432/retail

# Délai maximal de connexion à PostgreSQL, en secondes (défaut 10).
DB_CONNECT_TIMEOUT=10

# Base dédiée aux tests d'intégration (ils sont ignorés si elle est injoignable).
# ATTENTION : les tests vident les schémas du pipeline dans cette base.
TEST_DATABASE_URL=postgresql+psycopg://retail:change_me@localhost:5432/retail_test
